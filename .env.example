# Copy to .env and fill in. Never commit the real .env.

# --- OpenAI (required) ---
OPENAI_API_KEY=
# Leave default unless using a proxy / compatible gateway.
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Models ---
MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=insurance_policies

# --- Data paths ---
POLICY_PDF_PATH=./data/policy.pdf
COVERAGE_CSV_PATH=./data/coverage_data.csv

# --- Business rules ---
# Claims at or above this amount are flagged for manual review.
HIGH_AMOUNT_THRESHOLD=10000
